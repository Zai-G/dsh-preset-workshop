{
  "name": "dsh-preset-workshop",
  "version": "0.4.0",
  "description": "Preset Workshop · 预设工坊：让您的每一个Agent都有自己的工作方式",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zai-G/dsh-preset-workshop.git"
  },
  "homepage": "https://github.com/Zai-G/dsh-preset-workshop#readme",
  "bugs": {
    "url": "https://github.com/Zai-G/dsh-preset-workshop/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "preset",
    "agent",
    "prompt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/service/index.js",
    "./scope": "./lib/runtime/scope.js",
    "./client": "./lib/client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.core.json && node tools/build-client.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-scope": "^0.2.2-rc.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-scope": ">=v0.2.2-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "icon": "assets/color.png"
}
